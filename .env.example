# Copy this file to .env and change the values for your machine.
# .env is ignored by git - never commit real secrets.

# PostgreSQL (docker-compose service "db")
DATABASE_URL=postgresql+psycopg2://loan_user:change_me@localhost:5432/loan_db

# JWT auth for the FastAPI backend
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=60

# First admin user (created on API startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Saved sklearn pipeline (preprocessing + model)
MODEL_PATH=models/loan_default_model.joblib

# Where the Streamlit frontend finds the API
API_URL=http://localhost:8000
